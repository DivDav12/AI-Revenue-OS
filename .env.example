# Copy to .env (gitignored) and fill in. Never commit real credentials.
# These grant READ-ONLY access to PayPal orders + the Transaction Search API.
# They cannot send money, change an account, or create an obligation.

PAYPAL_CLIENT_ID=your-client-id
PAYPAL_CLIENT_SECRET=your-client-secret

# sandbox (default) | live
# Sandbox and live credentials are different -- get live ones from
# developer.paypal.com -> Apps & Credentials -> "Live" toggle.
# paypal-sync also needs the "Transaction Search" feature enabled on the app.
PAYPAL_ENV=sandbox

# Business contact address. Shown on the customer-facing checkout / intake
# pages (as the "if the form fails" fallback and page contact) and used by
# the operator to deliver the plan. Not a PayPal setting. `build-checkout`
# reads this (or --business-email). Leave blank to keep the generic wording.
BUSINESS_EMAIL=you@example.com

# CJ Affiliate (Commission Junction) real product search (Offer Discovery -
# see ecosystem/cj_offer_source.py). Requires: (1) an approved CJ publisher
# account, (2) approval into >=1 specific advertiser program(s) - the fleet
# never applies for either step itself. Generate the Personal Access Token
# in your CJ account (Account > API Keys / Personal Access Tokens).
# CJ_COMPANY_ID is your CJ company/publisher id.
# CJ_ADVERTISER_IDS is a comma-separated list of CJ advertiser/program ids
# you have ALREADY been approved for - never guessed, the search only ever
# queries programs listed here.
CJ_PERSONAL_ACCESS_TOKEN=your-cj-personal-access-token
CJ_COMPANY_ID=your-cj-company-id
CJ_ADVERTISER_IDS=1234567,2345678

# systeme.io curated affiliate offer (Offer Discovery - see
# ecosystem/systeme_offer_source.py). systeme.io has no public
# product-search API/catalog for affiliates - this is a single, verified
# affiliate link, not an automated marketplace connector. Set both to the
# EXACT values systeme.io issued you; SYSTEME_IO_AFFILIATE_URL's `sa=`
# query parameter must match SYSTEME_IO_AFFILIATE_ID exactly or the source
# refuses to load (fail closed).
SYSTEME_IO_AFFILIATE_ID=your-systeme-io-affiliate-id
SYSTEME_IO_AFFILIATE_URL=https://systeme.io/de?sa=your-systeme-io-affiliate-id

# Awin real physical-product data feed search (Offer Discovery - see
# ecosystem/awin_offer_source.py). Awin has no live product-search API -
# publishers get official, documented bulk product data feeds per
# approved advertiser; this connector downloads and searches those real
# feeds locally. Requires: (1) an approved Awin publisher account, (2)
# approval into >=1 specific advertiser program(s) - the fleet never
# applies for either step itself. Generate the datafeed API key via
# Create-a-Feed in your Awin account (Toolbox > Create-a-Feed) for each
# approved advertiser.
# AWIN_ADVERTISER_IDS is a comma-separated list of Awin advertiser ids you
# have ALREADY been approved for - never guessed, the search only ever
# reads feeds listed here.
AWIN_DATAFEED_API_KEY=your-awin-datafeed-api-key
AWIN_ADVERTISER_IDS=1234,5678

# Wondershare DE / PDFelement - a single, verified Awin affiliate offer
# (Awin advertiser 20202), integrated from one real tracking link rather
# than a product data feed (see ecosystem/wondershare_offer_source.py).
# Used only when AWIN_DATAFEED_API_KEY above is NOT set. Set both to your
# real values; WONDERSHARE_AWIN_TRACKING_URL must be the exact
# www.awin1.com/cread.php deep link Awin issued (awinmid=20202,
# awinaffid=<your publisher id>, ued=<a wondershare.com https page>) or
# the source refuses to load (fail closed).
WONDERSHARE_AWIN_PUBLISHER_ID=your-awin-publisher-id
WONDERSHARE_AWIN_TRACKING_URL=https://www.awin1.com/cread.php?awinmid=20202&awinaffid=your-awin-publisher-id&ued=https%3A%2F%2Fpdf.wondershare.com%2Fpdfelement.html
