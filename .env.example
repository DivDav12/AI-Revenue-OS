# Copy to .env (gitignored) and fill in. Never commit real credentials.
# These grant READ-ONLY access to PayPal orders + the Transaction Search API.
# They cannot send money, change an account, or create an obligation.

PAYPAL_CLIENT_ID=your-client-id
PAYPAL_CLIENT_SECRET=your-client-secret

# sandbox (default) | live  -- stays sandbox unless you set this to live
PAYPAL_ENV=sandbox
